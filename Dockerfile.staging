# Multi-stage Dockerfile for jsonhero.net staging
# Stage 1: Build ASP.NET Core backend
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS backend-build
WORKDIR /src
COPY backend/JsonHero.Api/JsonHero.Api.csproj backend/JsonHero.Api/
RUN dotnet restore backend/JsonHero.Api/JsonHero.Api.csproj
COPY backend/ .
RUN dotnet publish JsonHero.Api/JsonHero.Api.csproj -c Release -o /app/backend

# Stage 2: Build Vite React frontend
FROM node:22-alpine AS frontend-build
WORKDIR /src
COPY ClientApp/package.json ClientApp/package-lock.json ./
RUN npm ci
COPY ClientApp/ .
RUN npm run build

# Stage 3: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=backend-build /app/backend .
COPY --from=frontend-build /src/dist ./wwwroot
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Staging
EXPOSE 8080
ENTRYPOINT ["dotnet", "JsonHero.Api.dll"]
